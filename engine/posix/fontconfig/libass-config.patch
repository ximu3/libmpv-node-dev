 #define MAX_NAME 100
 
+static char *package_config(void)
+{
+    Dl_info library;
+    if (!dladdr((const void *)package_config, &library) || !library.dli_fname)
+        return NULL;
+
+    const char *end = strrchr(library.dli_fname, '/');
+    if (!end)
+        return NULL;
+
+    static const char config[] = "/fonts.conf";
+    size_t directory = end - library.dli_fname;
+    char *path = malloc(directory + sizeof(config));
+    if (path) {
+        memcpy(path, library.dli_fname, directory);
+        memcpy(path + directory, config, sizeof(config));
+    }
+    return path;
+}
