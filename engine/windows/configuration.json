{
  "ffmpegOptions": [
    "--enable-shared",
    "--disable-static",
    "--disable-gpl",
    "--disable-nonfree",
    "--disable-version3",
    "--disable-autodetect",
    "--disable-programs",
    "--disable-doc",
    "--disable-debug",
    "--enable-network",
    "--enable-schannel",
    "--enable-w32threads",
    "--enable-d3d11va",
    "--enable-dxva2",
    "--enable-libdav1d",
    "--enable-libopus",
    "--enable-libvorbis",
    "--enable-libvpx",
    "--enable-libass",
    "--enable-libsoxr",
    "--enable-libzimg",
    "--enable-libxml2",
    "--enable-zlib",
    "--enable-bzlib",
    "--enable-lzma",
    "--enable-iconv",
    "--extra-libs=-liconv",
    "--enable-libplacebo",
    "--enable-vulkan"
  ],
  "mpvOptions": [
    "--buildtype=release",
    "--wrap-mode=nodownload",
    "--auto-features=disabled",
    "-Dlibmpv=true",
    "-Dcplayer=false",
    "-Dbuild-date=false",
    "-Dgpl=false",
    "-Dlua=luajit",
    "-Djavascript=enabled",
    "-Dwin32-threads=enabled",
    "-Dd3d11=enabled",
    "-Dd3d-hwaccel=enabled",
    "-Dwasapi=enabled",
    "-Dshaderc=enabled",
    "-Dspirv-cross=enabled",
    "-Dgl=disabled",
    "-Diconv=enabled",
    "-Dzlib=enabled",
    "-Dlcms2=enabled",
    "-Dlibavdevice=enabled",
    "-Dlibcurl=disabled"
  ],
  "systemImports": [
    "advapi32.dll",
    "api-ms-win-core-path-l1-1-0.dll",
    "api-ms-win-core-synch-l1-2-0.dll",
    "api-ms-win-crt-convert-l1-1-0.dll",
    "api-ms-win-crt-environment-l1-1-0.dll",
    "api-ms-win-crt-filesystem-l1-1-0.dll",
    "api-ms-win-crt-heap-l1-1-0.dll",
    "api-ms-win-crt-locale-l1-1-0.dll",
    "api-ms-win-crt-math-l1-1-0.dll",
    "api-ms-win-crt-multibyte-l1-1-0.dll",
    "api-ms-win-crt-private-l1-1-0.dll",
    "api-ms-win-crt-process-l1-1-0.dll",
    "api-ms-win-crt-runtime-l1-1-0.dll",
    "api-ms-win-crt-stdio-l1-1-0.dll",
    "api-ms-win-crt-string-l1-1-0.dll",
    "api-ms-win-crt-time-l1-1-0.dll",
    "api-ms-win-crt-utility-l1-1-0.dll",
    "avicap32.dll",
    "avrt.dll",
    "bcrypt.dll",
    "bcryptprimitives.dll",
    "cfgmgr32.dll",
    "crypt32.dll",
    "dwmapi.dll",
    "dwrite.dll",
    "gdi32.dll",
    "imm32.dll",
    "kernel32.dll",
    "ncrypt.dll",
    "ntdll.dll",
    "ole32.dll",
    "oleaut32.dll",
    "rpcrt4.dll",
    "secur32.dll",
    "shcore.dll",
    "shell32.dll",
    "shlwapi.dll",
    "user32.dll",
    "userenv.dll",
    "usp10.dll",
    "uxtheme.dll",
    "version.dll",
    "ws2_32.dll"
  ],
  "libassOptions": [
    "--wrap-mode=nodownload",
    "--auto-features=disabled",
    "--buildtype=release",
    "--default-library=shared",
    "-Ddirectwrite=enabled",
    "-Dfontconfig=disabled",
    "-Dcoretext=disabled",
    "-Dlibunibreak=enabled",
    "-Dasm=enabled"
  ]
}
